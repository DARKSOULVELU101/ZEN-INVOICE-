generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SystemRole {
  OWNER
  ADMIN
  ACCOUNTANT
  FINANCE_MANAGER
  SALES_PERSON
  VIEWER
  AUDITOR
}

enum PermissionEffect {
  GRANT
  DENY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  SERVICE
  GOOD
}

enum AddressType {
  BILLING
  SHIPPING
}

enum TaxType {
  VAT
  GST
  SALES_TAX
  SST
  WITHHOLDING
  OTHER
}

enum TaxComponent {
  CGST
  SGST
  IGST
  GST
  VAT
  SALES_TAX
  OTHER
}

enum CurrencyCode {
  INR
  USD
  EUR
  GBP
  AED
}

enum ReportType {
  SALES
  REVENUE
  GST
  OUTSTANDING
  CUSTOMER_REVENUE
}

enum ReportStatus {
  READY
  GENERATING
  FAILED
}

enum DocumentType {
  INVOICE
  CUSTOMER
  ESTIMATE
  SALES_ORDER
  PURCHASE_ORDER
  BILL
  CREDIT_NOTE
  PAYMENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceEventType {
  CREATED
  UPDATED
  SENT
  VIEWED
  PAYMENT_RECEIVED
  CANCELLED
  REVISION_CREATED
  EMAIL_FAILED
  PDF_GENERATED
  PDF_DOWNLOADED
  PRINTED
}

enum ViewStatus {
  UNVIEWED
  VIEWED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  ONLINE
  OTHER
}

enum EntityType {
  ORGANIZATION
  USER
  CUSTOMER
  PRODUCT
  TAX
  INVOICE
  INVOICE_ITEM
  PAYMENT
  PAYMENT_APPLICATION
  BANK_ACCOUNT
  BANK_TRANSACTION
  WAREHOUSE
  INVENTORY_MOVEMENT
  AUDIT_LOG
  REPORT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SEND
  VIEW
  APPROVE
  CANCEL
  PAYMENT_RECORD
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOCKOUT
  PERMISSION_CHANGE
  EXPORT
  PRINT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum EmailDeliveryStatus {
  NOT_SENT
  DELIVERED
  FAILED
}

enum MovementDirection {
  IN
  OUT
  ADJUSTMENT
}

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  legalName        String?
  logoUrl          String?            @map("logo_url")
  taxId            String?
  gstin            String?            @db.VarChar(15)
  stateCode        String?            @db.VarChar(2)
  baseCurrencyCode CurrencyCode       @default(INR)
  locale           String             @default("en-US")
  timezone         String             @default("UTC")
  status           OrganizationStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  settings            OrganizationSetting?
  branches            Branch[]
  memberships         OrganizationMembership[]
  roles               Role[]
  permissionOverrides UserPermissionOverride[]
  customers           Customer[]
  customerAddresses   CustomerAddress[]
  products            Product[]
  taxes               Tax[]
  numberSequences     NumberSequence[]
  invoices            Invoice[]
  invoiceDocuments    InvoiceDocument[]
  payments            Payment[]
  exchangeRates       ExchangeRate[]
  auditLogs           AuditLog[]
  attachments         Attachment[]
  emailOutbox         EmailOutbox[]
  bankAccounts        BankAccount[]
  warehouses          Warehouse[]
  inventoryMovements  InventoryMovement[]
  reports             Report[]
  reportInvoices      ReportInvoice[]

  @@index([status, createdAt(sort: Desc)])
}

model OrganizationSetting {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @unique @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultCurrencyCode  CurrencyCode @default(INR)
  fiscalYearStartMonth Int          @default(1)
  invoicePrefix        String       @default("INV")
  invoiceDueDays       Int          @default(30)
  invoiceTerms         String?
  invoiceFooter        String?
  defaultTaxId         String?      @db.Uuid
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Branch {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                  String
  code                  String
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  stateCode             String?          @db.VarChar(2)
  postalCode            String?
  countryCode           String?          @db.VarChar(2)
  taxRegistrationNumber String?
  gstin                 String?          @db.VarChar(15)
  isPrimary             Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  invoices              Invoice[]
  numberSequences       NumberSequence[]
  warehouses            Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId, createdAt(sort: Desc)])
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("en-US")
  timezone     String     @default("UTC")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  memberships         OrganizationMembership[]
  createdInvoices     Invoice[]                @relation("InvoiceCreatedBy")
  approvedInvoices    Invoice[]                @relation("InvoiceApprovedBy")
  sentInvoices        Invoice[]                @relation("InvoiceSentBy")
  createdRevisions    InvoiceRevision[]        @relation("RevisionChangedBy")
  createdPayments     Payment[]                @relation("PaymentCreatedBy")
  createdReports      Report[]                 @relation("ReportCreatedBy")
  permissionOverrides UserPermissionOverride[]
  invoiceEvents       InvoiceEvent[]           @relation("InvoiceEventActor")
  auditLogs           AuditLog[]
  attachments         Attachment[]
  sessions            UserSession[]

  @@index([status])
}

model UserSession {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key            String    @id @db.VarChar(64)
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model OrganizationMembership {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String                   @db.Uuid
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              MembershipStatus         @default(ACTIVE)
  title               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  roles               MembershipRole[]
  permissionOverrides UserPermissionOverride[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  isSystem       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  memberships    MembershipRole[]
  permissions    RolePermission[]
  overrides      UserPermissionOverride[]

  @@unique([organizationId, key])
}

model MembershipRole {
  id           String                 @id @default(uuid()) @db.Uuid
  membershipId String                 @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String                 @db.Uuid
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())

  @@unique([membershipId, roleId])
}

model Permission {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique
  module          String
  description     String?
  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermissionOverride {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String                 @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId   String                 @db.Uuid
  membership     OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId         String?                @db.Uuid
  role           Role?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permissionId   String                 @db.Uuid
  permission     Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect         PermissionEffect
  createdAt      DateTime               @default(now())

  @@unique([organizationId, userId, permissionId])
}

model Customer {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerNumber   String
  displayName      String
  legalName        String?
  email            String?
  phone            String?
  taxId            String?
  gstin            String?           @db.VarChar(15)
  stateCode        String?           @db.VarChar(2)
  currencyCode     CurrencyCode?     @default(INR)
  paymentTermsDays Int?
  status           CustomerStatus    @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  addresses        CustomerAddress[]
  invoices         Invoice[]
  payments         Payment[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, displayName])
  @@index([organizationId, createdAt(sort: Desc)])
}

model CustomerAddress {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String       @db.Uuid
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            AddressType
  line1           String
  line2           String?
  city            String
  state           String?
  stateCode       String?      @db.VarChar(2)
  postalCode      String?
  countryCode     String       @db.VarChar(2)
  taxJurisdiction String?
  isDefault       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, customerId])
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sku                String
  name               String
  description        String?
  type               ProductType         @default(SERVICE)
  unitOfMeasure      String              @default("ea")
  salePrice          Decimal             @default(0) @db.Decimal(19, 4)
  currencyCode       CurrencyCode        @default(INR)
  hsnSac             String?             @db.VarChar(20)
  isTaxable          Boolean             @default(true)
  status             CustomerStatus      @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  invoiceItems       InvoiceItem[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model Tax {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  rate             Decimal          @db.Decimal(9, 6)
  type             TaxType
  component        TaxComponent?
  jurisdiction     String           @default("DEFAULT")
  stateCode        String?          @db.VarChar(2)
  isCompound       Boolean          @default(false)
  isInclusive      Boolean          @default(false)
  status           CustomerStatus   @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  invoiceItemTaxes InvoiceItemTax[]

  @@unique([organizationId, name, jurisdiction])
  @@index([organizationId, type])
}

model Currency {
  code          String  @id @db.VarChar(3)
  name          String
  symbol        String
  decimalPlaces Int     @default(2)
  isActive      Boolean @default(true)
}

model ExchangeRate {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromCurrencyCode CurrencyCode
  toCurrencyCode   CurrencyCode
  rate             Decimal      @db.Decimal(19, 8)
  rateDate         DateTime     @db.Date
  source           String       @default("MANUAL")
  createdAt        DateTime     @default(now())

  @@unique([organizationId, fromCurrencyCode, toCurrencyCode, rateDate])
  @@index([organizationId, toCurrencyCode, rateDate(sort: Desc)])
}

model NumberSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @db.Uuid
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documentType   DocumentType
  period         Int
  scopeKey       String       @default("DEFAULT")
  prefix         String
  suffix         String       @default("")
  padding        Int          @default(5)
  nextNumber     Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, documentType, period, scopeKey])
  @@index([organizationId, documentType, period])
}

model Invoice {
  id                      String               @id @default(uuid()) @db.Uuid
  organizationId          String               @db.Uuid @map("organization_id")
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId              String               @db.Uuid @map("customer_id")
  customer                Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId                String?              @db.Uuid @map("branch_id")
  branch                  Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoiceNumber           String               @map("invoice_number")
  status                  InvoiceStatus        @default(DRAFT)
  viewStatus              ViewStatus           @default(UNVIEWED) @map("view_status")
  version                 Int                  @default(1)
  currencyCode            CurrencyCode         @default(INR) @map("currency_code")
  baseCurrencyCode        CurrencyCode         @default(INR) @map("base_currency_code")
  exchangeRate            Decimal              @default(1) @db.Decimal(19, 8) @map("exchange_rate")
  gstin                   String?              @db.VarChar(15)
  sourceStateCode         String?              @db.VarChar(2) @map("source_state_code")
  destinationStateCode    String?              @db.VarChar(2) @map("destination_state_code")
  placeOfSupplyCode       String?              @db.VarChar(2) @map("place_of_supply_code")
  isReverseCharge         Boolean              @default(false) @map("is_reverse_charge")
  invoiceDate             DateTime             @db.Date @map("invoice_date")
  issueDate               DateTime             @db.Date @map("issue_date")
  paymentTerms            Int                  @default(30) @map("payment_terms")
  dueDate                 DateTime             @db.Date @map("due_date")
  reference               String?
  notes                   String?
  terms                   String?
  footer                  String?
  subtotal                Decimal              @default(0) @db.Decimal(19, 4)
  discountAmount          Decimal              @default(0) @db.Decimal(19, 4) @map("discount_amount")
  taxableAmount           Decimal              @default(0) @db.Decimal(19, 4) @map("taxable_amount")
  shippingAmount          Decimal              @default(0) @db.Decimal(19, 4) @map("shipping_amount")
  roundOffAmount          Decimal              @default(0) @db.Decimal(19, 4) @map("round_off_amount")
  cgstAmount              Decimal              @default(0) @db.Decimal(19, 4) @map("cgst_amount")
  sgstAmount              Decimal              @default(0) @db.Decimal(19, 4) @map("sgst_amount")
  igstAmount              Decimal              @default(0) @db.Decimal(19, 4) @map("igst_amount")
  taxAmount               Decimal              @default(0) @db.Decimal(19, 4) @map("tax_amount")
  total                   Decimal              @default(0) @db.Decimal(19, 4)
  amountPaid              Decimal              @default(0) @db.Decimal(19, 4) @map("amount_paid")
  balanceDue              Decimal              @default(0) @db.Decimal(19, 4) @map("balance_due")
  sentAt                  DateTime?            @map("sent_at")
  viewedAt                DateTime?            @map("viewed_at")
  cancelledAt             DateTime?            @map("cancelled_at")
  cancelReason            String?              @map("cancel_reason")
  emailDeliveryStatus     EmailDeliveryStatus  @default(NOT_SENT) @map("email_status")
  emailDeliveredAt        DateTime?            @map("email_delivered_at")
  emailLastError          String?              @map("email_last_error")
  customerNameSnapshot    String?              @map("customer_name_snapshot")
  customerEmailSnapshot   String?              @map("customer_email_snapshot")
  customerCompanySnapshot String?              @map("customer_company_snapshot")
  pdfUrl                  String?              @map("pdf_url")
  pdfKey                  String?              @map("pdf_key")
  pdfGeneratedAt          DateTime?            @map("pdf_generated_at")
  pdfHash                 String?              @db.VarChar(64) @map("pdf_hash")
  pdfVersion              Int                  @default(0) @map("pdf_version")
  printedAt               DateTime?            @map("printed_at")
  lastExportedAt          DateTime?            @map("last_exported_at")
  searchText              String               @default("") @map("search_text")
  createdById             String               @db.Uuid @map("created_by_id")
  createdBy               User                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById            String?              @db.Uuid @map("approved_by_id")
  approvedBy              User?                @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sentById                String?              @db.Uuid @map("sent_by_id")
  sentBy                  User?                @relation("InvoiceSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  deletedAt               DateTime?            @map("deleted_at")
  items                   InvoiceItem[]
  events                  InvoiceEvent[]
  revisions               InvoiceRevision[]
  applications            PaymentApplication[]
  payments                Payment[]            @relation("InvoicePayments")
  reportInvoices          ReportInvoice[]
  emailOutbox             EmailOutbox[]
  documents               InvoiceDocument[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@index([organizationId, status, balanceDue, dueDate])
  @@index([organizationId, issueDate(sort: Desc), id(sort: Desc)])
  @@index([organizationId, invoiceDate(sort: Desc), id(sort: Desc)])
  @@index([organizationId, invoiceNumber])
  @@index([organizationId, total(sort: Desc)])
  @@index([organizationId, deletedAt, issueDate(sort: Desc)])
  @@index([organizationId, deletedAt, invoiceDate(sort: Desc)])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, searchText])
}

model InvoiceItem {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  invoiceId       String           @db.Uuid
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?          @db.Uuid
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  position        Int
  description     String
  skuSnapshot     String?
  hsnSac          String?          @db.VarChar(20)
  unitOfMeasure   String           @default("ea")
  quantity        Decimal          @db.Decimal(19, 4)
  unitPrice       Decimal          @db.Decimal(19, 4)
  discountPercent Decimal          @default(0) @db.Decimal(9, 4)
  discountAmount  Decimal          @default(0) @db.Decimal(19, 4)
  taxable         Boolean          @default(true)
  taxableAmount   Decimal          @default(0) @db.Decimal(19, 4)
  cgstAmount      Decimal          @default(0) @db.Decimal(19, 4)
  sgstAmount      Decimal          @default(0) @db.Decimal(19, 4)
  igstAmount      Decimal          @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal          @default(0) @db.Decimal(19, 4)
  amount          Decimal          @db.Decimal(19, 4)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taxes           InvoiceItemTax[]

  @@unique([invoiceId, position])
  @@index([organizationId, invoiceId])
  @@index([organizationId, productId])
}

model InvoiceItemTax {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceItemId  String        @db.Uuid
  invoiceItem    InvoiceItem   @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  taxId          String        @db.Uuid
  tax            Tax           @relation(fields: [taxId], references: [id], onDelete: Restrict)
  nameSnapshot   String
  component      TaxComponent?
  rateSnapshot   Decimal       @db.Decimal(9, 6)
  taxableAmount  Decimal       @default(0) @db.Decimal(19, 4)
  amount         Decimal       @db.Decimal(19, 4)
  createdAt      DateTime      @default(now())

  @@unique([invoiceItemId, taxId])
  @@index([organizationId, component])
}

model InvoiceRevision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  version        Int
  reason         String?
  snapshot       Json
  changedById    String   @db.Uuid
  changedBy      User     @relation("RevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([invoiceId, version])
}

model InvoiceEvent {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  invoiceId      String           @db.Uuid
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type           InvoiceEventType
  message        String?
  metadata       Json?
  actorId        String?          @db.Uuid
  actor          User?            @relation("InvoiceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([invoiceId, createdAt(sort: Desc)])
}

model InvoiceDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String       @db.Uuid @map("invoice_id")
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storageKey     String       @map("storage_key")
  version        Int
  fileSizeBytes  Int          @map("file_size_bytes")
  sha256         String       @db.VarChar(64)
  mimeType       String       @default("application/pdf") @map("mime_type")
  generatedAt    DateTime     @map("generated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([invoiceId, version], name: "InvoiceDocument_invoice_version_key")
  @@index([organizationId, invoiceId])
}

model Payment {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId           String               @db.Uuid
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId            String?              @db.Uuid
  invoice              Invoice?             @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentNumber        String
  amount               Decimal              @db.Decimal(19, 4)
  unappliedAmount      Decimal              @default(0) @db.Decimal(19, 4)
  currencyCode         CurrencyCode         @default(INR)
  baseCurrencyCode     CurrencyCode         @default(INR)
  exchangeRate         Decimal              @default(1) @db.Decimal(19, 8)
  amountInBaseCurrency Decimal              @default(0) @db.Decimal(19, 4)
  paidAt               DateTime             @db.Date
  method               PaymentMethod
  reference            String?
  status               PaymentStatus        @default(COMPLETED)
  createdById          String               @db.Uuid
  createdBy            User                 @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  applications         PaymentApplication[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, customerId, paidAt(sort: Desc)])
  @@index([organizationId, invoiceId, paidAt(sort: Desc)])
  @@index([organizationId, status, paidAt(sort: Desc)])
}

model PaymentApplication {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  paymentId      String   @db.Uuid
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId      String   @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentId])
}

model Report {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ReportType
  name           String
  parameters     Json
  status         ReportStatus    @default(READY)
  generatedAt    DateTime?
  createdById    String          @db.Uuid
  createdBy      User            @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  invoices       ReportInvoice[]

  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, deletedAt])
}

model ReportInvoice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId       String       @db.Uuid
  report         Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  invoiceId      String       @db.Uuid
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([reportId, invoiceId])
  @@index([organizationId, invoiceId])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?      @db.Uuid
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         AuditAction
  entityType     EntityType
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, correlationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entityType     EntityType
  entityId       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  uploadedById   String       @db.Uuid
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  @@index([organizationId, entityType, entityId])
}

model EmailOutbox {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType         EntityType
  entityId           String
  invoiceId          String?      @db.Uuid
  invoice            Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  toAddress          String
  fromAddress        String?
  replyTo            String?
  ccAddresses        String[]     @default([])
  bccAddresses       String[]     @default([])
  subject            String
  bodyText           String?
  bodyHtml           String?
  templateKey        String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentData     Bytes?
  provider           String?
  providerMessageId  String?
  lastError          String?
  status             OutboxStatus @default(PENDING)
  attempts           Int          @default(0)
  scheduledAt        DateTime     @default(now())
  nextAttemptAt      DateTime     @default(now())
  lockedAt           DateTime?
  sentAt             DateTime?
  createdAt          DateTime     @default(now())
  purpose            String       @default("INVOICE_SEND")
  idempotencyKey     String       @db.VarChar(64)

  @@unique([organizationId, idempotencyKey], name: "EmailOutbox_org_idempotency_key")
  @@index([organizationId, status, nextAttemptAt])
  @@index([invoiceId, purpose, createdAt])
  @@index([status, scheduledAt])
}

model BankAccount {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  institution         String?
  accountNumberMasked String?
  currencyCode        String            @db.VarChar(3)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  transactions        BankTransaction[]

  @@unique([organizationId, name])
}

model BankTransaction {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  bankAccountId  String      @db.Uuid
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  externalId     String
  postedAt       DateTime
  description    String
  amount         Decimal     @db.Decimal(19, 4)
  currencyCode   String      @db.VarChar(3)
  isReconciled   Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@unique([organizationId, bankAccountId, externalId])
  @@index([organizationId, postedAt(sort: Desc)])
}

model Warehouse {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?             @db.Uuid
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  code           String
  createdAt      DateTime            @default(now())
  movements      InventoryMovement[]

  @@unique([organizationId, code])
}

model InventoryMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String            @db.Uuid
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId    String            @db.Uuid
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  direction      MovementDirection
  quantity       Decimal           @db.Decimal(19, 4)
  referenceType  EntityType?
  referenceId    String?
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([organizationId, productId, occurredAt(sort: Desc)])
}
