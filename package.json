{
  "name": "erp-invoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "check:pdf-trace": "node scripts/check-pdf-trace.cjs",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:setup": "node tests/e2e/generate-cert.cjs && node scripts/e2e-db-setup.cjs",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:email-api": "python -m pytest services/email-api/tests -q",
    "audit:prod": "node scripts/audit-production.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:pdf-trace && npm run audit:prod",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed:dev": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "preflight": "node scripts/run-with-vercel-env.cjs npx tsx scripts/production-preflight.ts",
    "db:audit": "node scripts/run-with-vercel-env.cjs npx tsx scripts/dependency-audit.ts",
    "check:schema": "node scripts/run-with-vercel-env.cjs npx tsx scripts/production-schema-audit.ts",
    "db:repair-ledger": "node scripts/run-with-vercel-env.cjs npx tsx prisma/repair-payment-ledger.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-ses": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "prisma": "^6.7.0",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5"
  }
}
